# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nse_stock_data

# Scraper Configuration
SCRAPE_INTERVAL_MINUTES=15
MAX_RETRIES=3
RETRY_DELAY_MS=2000
REQUEST_DELAY_MS=1000

# Watchlist Configuration (comma-separated symbols)
WATCHLIST_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,WIPRO,BHARTIARTL,ITC,SBIN,LT

# Index List (comma-separated)
INDEX_LIST=NIFTY 50,NIFTY BANK,NIFTY IT,NIFTY AUTO

# Enable/Disable Features
ENABLE_EQUITY_SCRAPING=true
ENABLE_INDEX_SCRAPING=true
ENABLE_OPTIONS_SCRAPING=false
ENABLE_HISTORICAL_SCRAPING=true
ENABLE_MARKET_MOVERS=true

# Historical Data Range (in days)
HISTORICAL_DAYS=30

# Logging
LOG_LEVEL=info
